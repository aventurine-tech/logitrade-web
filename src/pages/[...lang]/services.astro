---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<Base locale={locale} title={d.services.title}>
  <PageHero title={d.services.title} lead={d.services.lead} />

  {
    d.services.items.map((s, i) => (
      <section id={s.id} class:list={['section', 'service', { 'section--alt': i % 2 === 1 }]}>
        <div class="container service__inner reveal">
          <div>
            <ServiceIcon name={s.id} />
            <h2>{s.name}</h2>
            <p class="service__short">{s.short}</p>
          </div>
          <div>
            <p>{s.body}</p>
            <ul class="checklist">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand locale={locale} />
</Base>

<style>
  .service {
    scroll-margin-top: var(--header-h);
  }
  .service__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 64px;
    align-items: start;
  }
  .service__short {
    color: var(--muted);
    font-size: 1.15rem;
  }
</style>
