---
// Localised "page not found" page; /404.html forwards /en/... and /ru/... here.
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = () => localePaths().filter((p) => p.props.locale !== 'ro');
const { locale } = Astro.props as { locale: Locale };
---

<Base locale={locale} title={t(locale).notFound.title} noindex route="/">
  <NotFound locale={locale} />
</Base>
