---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { company, localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<Base locale={locale} title={d.careers.title}>
  <PageHero title={d.careers.title} lead={d.careers.lead} />

  <section class="section">
    <div class="container">
      <p class="careers__intro">{d.careers.intro}</p>
      <div class="grid grid--3">
        {
          d.careers.jobs.map((job) => (
            <article class="card job reveal">
              <span class="job__place">{job.place}</span>
              <h3>{job.title}</h3>
              <p>{job.text}</p>
              <a
                class="btn btn--primary"
                href={`mailto:${company.email}?subject=${encodeURIComponent(job.title)}`}
              >
                {d.careers.apply}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .careers__intro {
    color: var(--muted);
    margin-bottom: 32px;
  }
  .job {
    display: flex;
    flex-direction: column;
  }
  .job p {
    flex: 1;
  }
  .job .btn {
    align-self: flex-start;
    margin-top: 12px;
  }
  .job__place {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--amber-600);
    margin-bottom: 8px;
  }
</style>
