---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import { localePaths, t, type Locale } from '../../i18n';
import { getJobs } from '../../data/jobs';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
// Vacancies are edited in Pages CMS; see src/content/jobs/ and .pages.yml.
const jobs = await getJobs(locale);
---

<Base locale={locale} title={d.careers.title}>
  <PageHero title={d.careers.title} lead={d.careers.lead} />

  <section class="section">
    <div class="container">
      <p class="careers__intro">{d.careers.intro}</p>
      {jobs.length === 0 && <p class="card careers__none">{d.careers.noJobs}</p>}
      <div class="grid grid--3">
        {
          jobs.map((job) => (
            <article class="card job reveal">
              {job.place && <span class="job__place">{job.place}</span>}
              <h2 class="job__title">{job.title}</h2>
              <p>{job.text}</p>
              <a class="btn btn--primary" href="#form" data-apply={job.title}>
                {d.careers.apply}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container careers__form">
      <ContactForm locale={locale} topic="job" />
    </div>
  </section>
</Base>

<script is:inline>
  // "Apply" on a job card preselects that position in the form below.
  document.querySelectorAll('[data-apply]').forEach(function (a) {
    a.addEventListener('click', function () {
      var select = document.querySelector('[data-position]');
      if (select) select.value = a.getAttribute('data-apply');
    });
  });
</script>

<style>
  .careers__form {
    max-width: 780px;
  }
  /* h2 for a correct heading order, styled like the other card titles. */
  .job__title {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .careers__none {
    margin-bottom: 32px;
  }
  .careers__intro {
    color: var(--muted);
    margin-bottom: 32px;
  }
  .job {
    display: flex;
    flex-direction: column;
  }
  .job p {
    flex: 1;
  }
  .job .btn {
    align-self: flex-start;
    margin-top: 12px;
  }
  .job__place {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-soft);
    margin-bottom: 8px;
  }
</style>
