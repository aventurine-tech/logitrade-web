---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { localePaths, path, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<Base locale={locale} title={d.thanks.title}>
  <PageHero title={d.thanks.title} lead={d.thanks.lead} />
  <section class="section">
    <div class="container">
      <a class="btn btn--primary" href={path(locale)}>{d.thanks.back}</a>
    </div>
  </section>
</Base>
