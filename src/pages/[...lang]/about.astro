---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Stats from '../../components/Stats.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import Channels from '../../components/Channels.astro';
import CtaBand from '../../components/CtaBand.astro';
import { localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<Base locale={locale} title={d.about.title}>
  <PageHero title={d.about.title} lead={d.about.lead} />

  <section class="section">
    <div class="container about">
      <p class="about__story reveal">{d.about.story}</p>
      <div class="grid grid--3">
        <div class="card reveal">
          <h2 class="about__card-title">{d.about.missionTitle}</h2>
          <p>{d.about.mission}</p>
        </div>
        <div class="card reveal">
          <h2 class="about__card-title">{d.about.visionTitle}</h2>
          <p>{d.about.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__head reveal">
        <h2>{d.about.valuesTitle}</h2>
      </div>
      <div class="grid grid--3">
        {
          d.about.values.map((v, i) => (
            <div class="value reveal">
              <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.name}</h3>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Stats locale={locale} />
  <CoverageMap locale={locale} />
  <Channels locale={locale} />
  <CtaBand locale={locale} />
</Base>

<style>
  /* h2 for a correct heading order, styled like the other card titles. */
  .about__card-title {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .about__story {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    max-width: 820px;
    margin-bottom: 48px;
  }
  .value__num {
    display: block;
    font-weight: 800;
    color: var(--amber-600);
    margin-bottom: 8px;
  }
  .value p {
    color: var(--muted);
  }
</style>
