---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm.astro';
import { company, localePaths, t, type Locale } from '../../i18n';
import { getContact } from '../../data/site';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const c = d.contact;
const contact = getContact(locale);
---

<Base locale={locale} title={c.title}>
  <PageHero title={c.title} lead={c.lead} />

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <div class="card reveal">
          <h2>{c.officeTitle}</h2>
          <p>{contact.address.map((line) => (<>{line}<br /></>))}</p>
        </div>
        <div class="card reveal">
          <h2>{c.emailTitle}</h2>
          <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </div>
        {
          contact.phone && (
            <div class="card reveal">
              <h2>{c.phoneTitle}</h2>
              <p><a href={contact.phoneHref}>{contact.phone}</a></p>
            </div>
          )
        }
        <div class="card reveal legal">
          <h2>{c.legalTitle}</h2>
          <dl>
            <dt>{c.legalName}</dt><dd>{company.legalName}</dd>
            <dt>{c.idno}</dt><dd>{company.idno}</dd>
            <dt>{c.registered}</dt><dd>{c.registeredDate}</dd>
            <dt>{c.licences}</dt><dd>{c.licenceList.join('; ')}</dd>
          </dl>
        </div>
      </div>

      <ContactForm locale={locale} />
    </div>
  </section>

  <section class="container map" aria-label={c.officeTitle}>
    <iframe
      title="Map"
      loading="lazy"
      src={`https://www.openstreetmap.org/export/embed.html?bbox=${company.geo.lon - 0.02}%2C${company.geo.lat - 0.009}%2C${company.geo.lon + 0.02}%2C${company.geo.lat + 0.009}&layer=mapnik&marker=${company.geo.lat}%2C${company.geo.lon}`}
    ></iframe>
  </section>
</Base>

<style>
  /* Card titles are h2 for a correct heading order, styled like h3. */
  .contact__info h2 {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .legal dl {
    margin: 0;
    display: grid;
    gap: 2px 0;
  }
  .legal dt {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 8px;
  }
  .legal dt:first-child {
    margin-top: 0;
  }
  .legal dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 32px;
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: 20px;
  }
  .map {
    margin-top: calc(clamp(56px, 8vw, 104px) * -0.5);
    margin-bottom: clamp(56px, 8vw, 104px);
    border-radius: var(--radius, 18px);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .map iframe {
    display: block;
    width: 100%;
    height: 380px;
    border: 0;
    filter: grayscale(0.4);
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .map iframe {
      height: 280px;
    }
  }
</style>
