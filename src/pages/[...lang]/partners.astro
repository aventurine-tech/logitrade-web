---
// "For producers and importers": why distribute with Logitrade, how it works,
// and a request form that goes to the office (topic=partner).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Stats from '../../components/Stats.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import ContactForm from '../../components/ContactForm.astro';
import { localePaths, t, type Locale } from '../../i18n';
import { getContact, getPartnerBenefits } from '../../data/site';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const p = d.partners;
const icons = ['reach', 'team', 'storage', 'reports'];
const benefits = getPartnerBenefits(locale);
const contact = getContact(locale);
---

<Base locale={locale} title={p.title} description={p.lead}>
  <PageHero title={p.title} lead={p.lead} />

  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <h2>{p.benefitsTitle}</h2>
        <p>{p.benefitsLead}</p>
      </div>
      <div class="grid grid--4">
        {
          benefits.map((b, i) => (
            <div class="card reveal">
              <ServiceIcon name={icons[i % icons.length]} />
              <h3>{b.name}</h3>
              <p>{b.text}</p>
            </div>
          ))
        }
      </div>
      <a class="btn btn--primary partners__cta reveal" href="#form">{p.heroCta}</a>
    </div>
  </section>

  <Stats locale={locale} />
  <CoverageMap locale={locale} />

  <section class="section section--alt">
    <div class="container">
      <div class="section__head reveal">
        <h2>{p.stepsTitle}</h2>
      </div>
      <ol class="grid grid--4 steps">
        {
          p.steps.map((s, i) => (
            <li class="step reveal">
              <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container partners__form">
      <ContactForm locale={locale} topic="partner" />
      <p class="partners__mail">
        {d.contact.emailTitle}: <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .partners__cta {
    margin-top: 32px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step__num {
    display: block;
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--accent-soft);
    margin-bottom: 8px;
  }
  .step p {
    color: var(--muted);
  }
  .partners__form {
    max-width: 780px;
  }
  .partners__mail {
    margin: 16px 0 0;
    text-align: center;
    color: var(--muted);
  }
</style>
