---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<Base locale={locale} title={d.privacy.title}>
  <PageHero title={d.privacy.title} lead={d.privacy.lead} />
  <section class="section">
    <div class="container prose">
      {
        d.privacy.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p>{s.text}</p>
          </>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .prose {
    max-width: 760px;
  }
  .prose h2 {
    font-size: 1.4rem;
    margin-top: 1.6em;
  }
</style>
