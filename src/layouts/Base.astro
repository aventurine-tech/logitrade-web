---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset, defaultLocale, locales, path, stripLocale, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  overlayHeader?: boolean;
}
const { locale, title, description, overlayHeader = true } = Astro.props;
const d = t(locale);
const pageTitle = title ? `${title} | Logitrade` : d.meta.title;
const pageDescription = description ?? d.meta.description;
const basePath = stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL('https://www.logitrade.md');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1f3c" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="canonical" href={new URL(path(locale, basePath), site)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(path(l, basePath), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path(defaultLocale, basePath), site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header locale={locale} overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
