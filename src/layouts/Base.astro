---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset, company, defaultLocale, locales, pageUrl, stripLocale, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  /** Keep the page out of search results (thank-you page, 404). */
  noindex?: boolean;
  /** Route to use for canonical/hreflang links instead of the current URL (the 404 page). */
  route?: string;
}
const { locale, title, description, overlayHeader = true, noindex = false, route } = Astro.props;
const d = t(locale);
const pageTitle = title ? `${title} | Logitrade` : d.meta.title;
const pageDescription = description ?? d.meta.description;
const basePath = route ?? stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL('https://logitrade.md');
const canonical = pageUrl(locale, basePath, site);
const ogLocale = { ro: 'ro_MD', en: 'en_US', ru: 'ru_MD' } satisfies Record<Locale, string>;
const ogImage = new URL(asset(`og/${locale}.png`), site).href;

// Company data for search engines (schema.org). Only facts from the state register.
const orgData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).href,
  name: company.name,
  legalName: 'Logitrade Group SRL',
  url: new URL(asset(''), site).href,
  logo: new URL(asset('logo.png'), site).href,
  email: company.email,
  foundingDate: company.registered,
  identifier: { '@type': 'PropertyValue', propertyID: 'IDNO', value: company.idno },
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.ro[0],
    postalCode: 'MD-2002',
    addressLocality: 'Chișinău',
    addressCountry: 'MD',
  },
  areaServed: { '@type': 'Country', name: 'Moldova' },
};

// Cloudflare Web Analytics: cookie-free, enabled only when the token is set at build time.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1f3c" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && locales.map((l) => <link rel="alternate" hreflang={l} href={pageUrl(l, basePath, site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={pageUrl(defaultLocale, basePath, site)} />}
    <meta property="og:site_name" content="Logitrade Group" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(orgData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header locale={locale} overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        ></script>
      )
    }
  </body>
</html>
