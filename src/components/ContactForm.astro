---
// The site's message form, used on the contact page and the producers page.
// It posts to the form worker (form-worker/) once the deploy sets its URL and the
// Turnstile site key; until then it just shows the thank-you page.
import { path, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** 'partner' adds company (required), phone and products fields. */
  topic?: 'contact' | 'partner';
}
const { locale, topic = 'contact' } = Astro.props;
const d = t(locale);
const c = d.contact;
const p = d.partners;
const partner = topic === 'partner';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const live = Boolean(endpoint && siteKey);
---

<form
  id="form"
  class="card form reveal"
  action={live ? endpoint : path(locale, '/thanks')}
  method={live ? 'post' : 'get'}
>
  <h2>{partner ? p.formTitle : c.formTitle}</h2>
  {partner && <p class="form__lead">{p.formLead}</p>}
  <input type="hidden" name="lang" value={locale} />
  <input type="hidden" name="topic" value={topic} />
  <label class="hp" aria-hidden="true">
    Website
    <input name="website" tabindex="-1" autocomplete="off" />
  </label>
  <div class="form__row">
    <label>
      {c.firstName} *
      <input name="firstName" autocomplete="given-name" maxlength="80" required />
    </label>
    <label>
      {c.lastName} *
      <input name="lastName" autocomplete="family-name" maxlength="80" required />
    </label>
  </div>
  {
    partner ? (
      <>
        <label>
          {p.company} *
          <input name="company" autocomplete="organization" maxlength="160" required />
        </label>
        <div class="form__row">
          <label>
            {c.email} *
            <input name="email" type="email" autocomplete="email" maxlength="200" required />
          </label>
          <label>
            {p.phone}
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </label>
        </div>
        <label>
          {p.products}
          <input name="products" maxlength="300" placeholder={p.productsHint} />
        </label>
      </>
    ) : (
      <>
        <label>
          {c.email} *
          <input name="email" type="email" autocomplete="email" maxlength="200" required />
        </label>
        <label>
          {c.company}
          <input name="company" autocomplete="organization" maxlength="160" />
        </label>
      </>
    )
  }
  <label>
    {partner ? p.message : c.message} *
    <textarea name="message" rows="5" maxlength="5000" required></textarea>
  </label>
  {live && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-language={locale} data-size="flexible"></div>}
  <p class="form__error" role="alert" data-form-error hidden></p>
  <button class="btn btn--primary" type="submit">{partner ? p.send : c.send}</button>
  {!partner && <p class="form__note">{c.formNote}</p>}
</form>

{live && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline define:vars={{ errors: c.formErrors }}>
  // The form worker redirects back with ?form=<reason> when a message could not be sent.
  var reason = new URLSearchParams(location.search).get('form');
  var box = document.querySelector('[data-form-error]');
  if (reason && box) {
    box.textContent = errors[reason] || errors.error;
    box.hidden = false;
  }
</script>

<style>
  #form {
    scroll-margin-top: 96px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__error {
    margin: 0;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(216, 52, 44, 0.18);
    border: 1px solid rgba(255, 120, 110, 0.45);
    color: #ffd9d5;
    font-size: 0.95rem;
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .form h2 {
    font-size: 1.6rem;
    margin: 0;
  }
  .form__lead {
    margin: -8px 0 0;
    color: var(--muted);
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .form label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .form input,
  .form textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    width: 100%;
  }
  .form input::placeholder,
  .form textarea::placeholder {
    color: rgba(226, 234, 245, 0.45);
  }
  .form input:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--amber-500);
    background: rgba(255, 255, 255, 0.12);
  }
  .form .btn {
    justify-self: start;
  }
  .form__note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 860px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .form .btn {
      justify-self: stretch;
    }
    .form {
      padding: 22px 18px;
    }
  }
</style>
