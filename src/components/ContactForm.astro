---
// The site's message form, used on the contact page and the producers page.
// It posts to the form worker (form-worker/) once the deploy sets its URL and the
// Turnstile site key; until then it just shows the thank-you page.
import { path, t, type Locale } from '../i18n';
import { getJobs } from '../data/jobs';

interface Props {
  locale: Locale;
  /**
   * 'partner' adds company (required), phone and products fields.
   * 'shop' asks for name, shop, town and phone; email and message are optional.
   * 'job' asks for name, phone and position, with an optional CV upload.
   */
  topic?: 'contact' | 'partner' | 'shop' | 'job';
}
const { locale, topic = 'contact' } = Astro.props;
const d = t(locale);
const c = d.contact;
const p = d.partners;
const partner = topic === 'partner';
const sh = d.shops;
const cr = d.careers;
const jobs = topic === 'job' ? await getJobs(locale) : [];
const title = { contact: c.formTitle, partner: p.formTitle, shop: sh.formTitle, job: cr.formTitle }[topic];
const lead = { contact: '', partner: p.formLead, shop: sh.formLead, job: cr.formLead }[topic];
const send = { contact: c.send, partner: p.send, shop: sh.send, job: cr.send }[topic];

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const live = Boolean(endpoint && siteKey);
---

<form
  id="form"
  class="card form reveal"
  action={live ? endpoint : path(locale, '/thanks')}
  method={live ? 'post' : 'get'}
  enctype={live && topic === 'job' ? 'multipart/form-data' : undefined}
>
  <h2>{title}</h2>
  {lead && <p class="form__lead">{lead}</p>}
  <input type="hidden" name="lang" value={locale} />
  <input type="hidden" name="topic" value={topic} />
  <label class="hp" aria-hidden="true">
    Website
    <input name="website" tabindex="-1" autocomplete="off" />
  </label>
  {
    topic === 'job' && (
      <>
        <div class="form__row">
          <label>
            {cr.name} *
            <input name="firstName" autocomplete="name" maxlength="80" required />
          </label>
          <label>
            {cr.phone} *
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" required />
          </label>
        </div>
        <div class="form__row">
          <label>
            {cr.position} *
            <select name="position" required data-position>
              {jobs.map((j) => <option value={j.title}>{j.title}</option>)}
              <option value={cr.other}>{cr.other}</option>
            </select>
          </label>
          <label>
            {cr.town}
            <input name="town" autocomplete="address-level2" maxlength="120" />
          </label>
        </div>
        <label>
          {cr.email}
          <input name="email" type="email" autocomplete="email" maxlength="200" />
        </label>
        <label>
          {cr.cv}
          <input
            name="cv"
            type="file"
            accept=".pdf,.doc,.docx,.odt,.rtf,.jpg,.jpeg,.png,.heic,.webp"
            data-cv
          />
          <small class="form__hint">{cr.cvHint}</small>
        </label>
        <label>
          {cr.message}
          <textarea name="message" rows="3" maxlength="5000"></textarea>
        </label>
      </>
    )
  }
  {
    topic === 'job' ? null : topic === 'shop' ? (
      <>
        <div class="form__row">
          <label>
            {sh.name} *
            <input name="firstName" autocomplete="name" maxlength="80" required />
          </label>
          <label>
            {sh.phone} *
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" required />
          </label>
        </div>
        <div class="form__row">
          <label>
            {sh.shop} *
            <input name="company" autocomplete="organization" maxlength="160" required />
          </label>
          <label>
            {sh.town} *
            <input name="town" autocomplete="address-level2" maxlength="120" required />
          </label>
        </div>
        <label>
          {sh.email}
          <input name="email" type="email" autocomplete="email" maxlength="200" />
        </label>
        <label>
          {sh.message}
          <textarea name="message" rows="3" maxlength="5000"></textarea>
        </label>
      </>
    ) : (
      <>
      <div class="form__row">
        <label>
          {c.firstName} *
          <input name="firstName" autocomplete="given-name" maxlength="80" required />
        </label>
        <label>
          {c.lastName} *
          <input name="lastName" autocomplete="family-name" maxlength="80" required />
        </label>
      </div>
      {
        partner ? (
          <>
            <label>
              {p.company} *
              <input name="company" autocomplete="organization" maxlength="160" required />
            </label>
            <div class="form__row">
              <label>
                {c.email} *
                <input name="email" type="email" autocomplete="email" maxlength="200" required />
              </label>
              <label>
                {p.phone}
                <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
              </label>
            </div>
            <label>
              {p.products}
              <input name="products" maxlength="300" placeholder={p.productsHint} />
            </label>
          </>
        ) : (
          <>
            <label>
              {c.email} *
              <input name="email" type="email" autocomplete="email" maxlength="200" required />
            </label>
            <label>
              {c.company}
              <input name="company" autocomplete="organization" maxlength="160" />
            </label>
          </>
        )
      }
      <label>
        {partner ? p.message : c.message} *
        <textarea name="message" rows="5" maxlength="5000" required></textarea>
      </label>
      </>
    )
  }
  {live && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-language={locale} data-size="flexible"></div>}
  <p class="form__error" role="alert" data-form-error hidden></p>
  <button class="btn btn--primary" type="submit">{send}</button>
  {topic === 'contact' && <p class="form__note">{c.formNote}</p>}
</form>

{live && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline define:vars={{ errors: c.formErrors }}>
  // The form worker redirects back with ?form=<reason> when a message could not be sent.
  var reason = new URLSearchParams(location.search).get('form');
  var box = document.querySelector('[data-form-error]');
  if (reason && box) {
    box.textContent = errors[reason] || errors.error;
    box.hidden = false;
  }
  // Check the CV before upload so a too-large file fails at once, not after sending.
  var cv = document.querySelector('[data-cv]');
  if (cv) {
    cv.addEventListener('change', function () {
      var f = cv.files && cv.files[0];
      cv.setCustomValidity(f && f.size > 5 * 1024 * 1024 ? errors.file : '');
      cv.reportValidity();
    });
  }
</script>

<style>
  #form {
    scroll-margin-top: 96px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__error {
    margin: 0;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(216, 52, 44, 0.18);
    border: 1px solid rgba(255, 120, 110, 0.45);
    color: #ffd9d5;
    font-size: 0.95rem;
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .form h2 {
    font-size: 1.6rem;
    margin: 0;
  }
  .form__lead {
    margin: -8px 0 0;
    color: var(--muted);
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .form label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .form input,
  .form select,
  .form textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    width: 100%;
  }
  .form input::placeholder,
  .form textarea::placeholder {
    color: rgba(226, 234, 245, 0.45);
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--accent-soft);
    background: rgba(255, 255, 255, 0.12);
  }
  .form .btn {
    justify-self: start;
  }
  .form select option {
    color: #0a1f3c;
  }
  .form input[type='file'] {
    padding: 10px;
    cursor: pointer;
  }
  .form input[type='file']::file-selector-button {
    font: inherit;
    font-weight: 600;
    margin-right: 12px;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }
  .form__hint {
    font-weight: 400;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .form__note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 860px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .form .btn {
      justify-self: stretch;
    }
    .form {
      padding: 22px 18px;
    }
  }
</style>
