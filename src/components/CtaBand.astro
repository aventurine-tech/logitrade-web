---
import { path, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="section">
  <div class="container">
    <div class="cta reveal">
      <div>
        <h2>{d.home.ctaTitle}</h2>
        <p>{d.home.ctaLead}</p>
      </div>
      <a class="btn btn--primary" href={path(locale, '/partners')}>{d.home.ctaButton}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: calc(var(--radius) * 1.5);
    background: linear-gradient(120deg, rgba(226, 67, 76, 0.18), rgba(37, 99, 184, 0.35));
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .cta h2 {
    margin-bottom: 8px;
  }
  .cta p {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
    max-width: 560px;
  }
</style>
