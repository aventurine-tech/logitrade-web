---
// Placeholder Logitrade mark: a stylised "L" that turns into a forward arrow.
// Replace with the final logo files when the brand is ready.
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light }]}>
  <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
    <rect width="36" height="36" rx="9" fill="#0f2c54"></rect>
    <path d="M11 8v17h11" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M21 19l6 6-6 6" fill="none" stroke="#f5a524" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" transform="translate(0 -6)"></path>
  </svg>
  <span class="logo__word">Logi<span>trade</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--navy-900);
  }
  .logo__word span {
    color: var(--amber-600);
  }
  .logo--light {
    color: #fff;
  }
  .logo--light .logo__word span {
    color: var(--amber-500);
  }
</style>
