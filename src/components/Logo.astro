---
// Logitrade Group logo (from the brand PDF). The site is dark, so the header and
// footer use the all-white version; `light={false}` gives the full-colour lockup.
import { brand, logoViewBox, markPath, wordPath } from '../data/logo';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
const mark = light ? '#ffffff' : brand.maroon;
const word = light ? '#ffffff' : brand.navy;
---

<span class="logo">
  <svg viewBox={logoViewBox} role="img" aria-label="Logitrade Group">
    <path fill={mark} fill-rule="evenodd" d={markPath}></path>
    <path fill={word} fill-rule="evenodd" d={wordPath}></path>
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
  }
  .logo svg {
    display: block;
    height: 42px;
    width: auto;
  }
  @media (max-width: 480px) {
    .logo svg {
      height: 36px;
    }
  }
</style>
